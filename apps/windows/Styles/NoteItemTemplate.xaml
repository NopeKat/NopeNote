<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 按 Gallery 3.0.4 AGENTS.md 的渐进式示例原则，只展示标题与摘要两个概念，保持模板小且可复用 -->
    <DataTemplate x:Key="NoteItemsViewItemTemplate">
        <ItemContainer AutomationProperties.Name="{Binding DisplayTitle}">
            <Grid Padding="{StaticResource NoteItemPadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xE840;"
                        AutomationProperties.AccessibilityView="Raw"
                        Visibility="{Binding PinVisibility}" />
                    <TextBlock
                        Grid.Column="1"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding DisplayTitle}"
                        TextTrimming="CharacterEllipsis" />
                    <CheckBox
                        Grid.Column="2"
                        MinWidth="0"
                        AutomationProperties.Name="{Binding SelectionCheckName}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Visibility="{Binding SelectionVisibility}" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    MaxLines="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding TagText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding TagVisibility}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    MaxLines="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding FolderText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding FolderVisibility}" />
                <TextBlock
                    Grid.Row="3"
                    Margin="0,2,0,0"
                    MaxLines="2"
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Text}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </ItemContainer>
    </DataTemplate>

    <DataTemplate x:Key="NoteItemTemplate">
        <Grid Padding="{StaticResource NoteItemPadding}" AutomationProperties.Name="{Binding DisplayTitle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="12"
                    Glyph="&#xE840;"
                    AutomationProperties.AccessibilityView="Raw"
                    Visibility="{Binding PinVisibility}" />
                <TextBlock
                    Grid.Column="1"
                    MaxLines="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding DisplayTitle}"
                    TextTrimming="CharacterEllipsis" />
                <CheckBox
                    Grid.Column="2"
                    MinWidth="0"
                    AutomationProperties.Name="Select note"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Visibility="{Binding SelectionVisibility}" />
            </Grid>
            <TextBlock
                Grid.Row="1"
                Margin="0,2,0,0"
                MaxLines="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding TagText}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding TagVisibility}" />
            <TextBlock
                Grid.Row="2"
                Margin="0,2,0,0"
                MaxLines="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding FolderText}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding FolderVisibility}" />
            <TextBlock
                Grid.Row="3"
                Margin="0,2,0,0"
                MaxLines="2"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding Text}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
