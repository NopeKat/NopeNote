<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 按 Gallery 3.0.4 AGENTS.md 的渐进式示例原则，只展示标题与摘要两个概念，保持模板小且可复用 -->
    <DataTemplate x:Key="NoteItemsViewItemTemplate">
        <ItemContainer AutomationProperties.Name="{Binding DisplayTitle}">
            <Grid Padding="{StaticResource NoteItemPadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Fluent UI System Icons: pin_16_regular; ink 11.98 x 12.00 -> 14.00 px long edge, centered on 16; 1 px bands after the 1 px correction. Source: fluentui-system-icons main (official SVG). -->
                    <PathIcon
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Data="F1 M14.48 5.6 L14.71 5.87 L14.81 6.05 L14.91 6.3 L14.97 6.56 L14.99 6.83 L14.97 7.09 L14.91 7.35 L14.82 7.59 L14.68 7.83 L14.56 7.99 L14.42 8.13 L14.13 8.34 L9.66 10.74 L8.56 14.04 L8.45 14.22 L8.28 14.35 L8.13 14.4 L7.96 14.41 L7.79 14.37 L7.64 14.29 L5.09 11.74 L2 14.83 L1.01 15 L1.18 14 L4.27 10.92 L1.72 8.36 L1.63 8.2 L1.59 8.01 L1.62 7.83 L1.7 7.66 L1.83 7.53 L1.98 7.45 L5.27 6.35 L7.66 1.86 L7.87 1.58 L8.02 1.43 L8.18 1.31 L8.41 1.17 L8.72 1.06 L9.05 1 L9.31 1.01 L9.64 1.06 L9.9 1.15 L10.14 1.29 L10.36 1.46 Z M6.04 7.03 L5.98 7.12 L5.81 7.22 L2.95 8.18 L7.83 13.06 L8.78 10.19 L8.88 10.04 L8.98 9.96 L13.65 7.46 L13.79 7.35 L13.89 7.21 L13.96 7.05 L13.99 6.89 L13.98 6.72 L13.95 6.58 L13.88 6.45 L13.79 6.33 L9.66 2.18 L9.54 2.09 L9.37 2.03 L9.2 2 L9.04 2.01 L8.87 2.06 L8.75 2.13 L8.62 2.25 L8.53 2.37 Z"
                        AutomationProperties.AccessibilityView="Raw"
                        Visibility="{Binding PinVisibility}" />
                    <TextBlock
                        Grid.Column="1"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding DisplayTitle}"
                        TextTrimming="CharacterEllipsis" />
                    <CheckBox
                        Grid.Column="2"
                        MinWidth="0"
                        AutomationProperties.Name="{Binding SelectionCheckName}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Visibility="{Binding SelectionVisibility}" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    MaxLines="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding TagText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding TagVisibility}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    MaxLines="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding FolderText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding FolderVisibility}" />
                <TextBlock
                    Grid.Row="3"
                    Margin="0,2,0,0"
                    MaxLines="2"
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Excerpt}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding ExcerptVisibility}" />
            </Grid>
        </ItemContainer>
    </DataTemplate>

    <DataTemplate x:Key="NoteItemTemplate">
        <Grid Padding="{StaticResource NoteItemPadding}" AutomationProperties.Name="{Binding DisplayTitle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Fluent UI System Icons: pin_16_regular; ink 11.98 x 12.00 -> 14.00 px long edge, centered on 16; 1 px bands after the 1 px correction. Source: fluentui-system-icons main (official SVG). -->
                <PathIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Data="F1 M14.48 5.6 L14.71 5.87 L14.81 6.05 L14.91 6.3 L14.97 6.56 L14.99 6.83 L14.97 7.09 L14.91 7.35 L14.82 7.59 L14.68 7.83 L14.56 7.99 L14.42 8.13 L14.13 8.34 L9.66 10.74 L8.56 14.04 L8.45 14.22 L8.28 14.35 L8.13 14.4 L7.96 14.41 L7.79 14.37 L7.64 14.29 L5.09 11.74 L2 14.83 L1.01 15 L1.18 14 L4.27 10.92 L1.72 8.36 L1.63 8.2 L1.59 8.01 L1.62 7.83 L1.7 7.66 L1.83 7.53 L1.98 7.45 L5.27 6.35 L7.66 1.86 L7.87 1.58 L8.02 1.43 L8.18 1.31 L8.41 1.17 L8.72 1.06 L9.05 1 L9.31 1.01 L9.64 1.06 L9.9 1.15 L10.14 1.29 L10.36 1.46 Z M6.04 7.03 L5.98 7.12 L5.81 7.22 L2.95 8.18 L7.83 13.06 L8.78 10.19 L8.88 10.04 L8.98 9.96 L13.65 7.46 L13.79 7.35 L13.89 7.21 L13.96 7.05 L13.99 6.89 L13.98 6.72 L13.95 6.58 L13.88 6.45 L13.79 6.33 L9.66 2.18 L9.54 2.09 L9.37 2.03 L9.2 2 L9.04 2.01 L8.87 2.06 L8.75 2.13 L8.62 2.25 L8.53 2.37 Z"
                    AutomationProperties.AccessibilityView="Raw"
                    Visibility="{Binding PinVisibility}" />
                <TextBlock
                    Grid.Column="1"
                    MaxLines="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding DisplayTitle}"
                    TextTrimming="CharacterEllipsis" />
                <CheckBox
                    Grid.Column="2"
                    MinWidth="0"
                    AutomationProperties.Name="Select note"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Visibility="{Binding SelectionVisibility}" />
            </Grid>
            <TextBlock
                Grid.Row="1"
                Margin="0,2,0,0"
                MaxLines="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding TagText}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding TagVisibility}" />
            <TextBlock
                Grid.Row="2"
                Margin="0,2,0,0"
                MaxLines="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding FolderText}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding FolderVisibility}" />
            <TextBlock
                Grid.Row="3"
                Margin="0,2,0,0"
                MaxLines="2"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding Excerpt}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding ExcerptVisibility}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
