<Page
    x:Class="NopeNote.Windows.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <DataTemplate x:Key="SearchResultTemplate">
            <Grid Padding="{StaticResource NoteItemPadding}" AutomationProperties.Name="{Binding DisplayTitle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Fluent UI System Icons: pin_16_regular; ink 11.98 x 12.00 -> 14.00 px long edge, centered on 16; 1 px bands after the 1 px correction. Source: fluentui-system-icons main (official SVG). -->
                    <PathIcon
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Data="F1 M14.48 5.6 L14.71 5.87 L14.81 6.05 L14.91 6.3 L14.97 6.56 L14.99 6.83 L14.97 7.09 L14.91 7.35 L14.82 7.59 L14.68 7.83 L14.56 7.99 L14.42 8.13 L14.13 8.34 L9.66 10.74 L8.56 14.04 L8.45 14.22 L8.28 14.35 L8.13 14.4 L7.96 14.41 L7.79 14.37 L7.64 14.29 L5.09 11.74 L2 14.83 L1.01 15 L1.18 14 L4.27 10.92 L1.72 8.36 L1.63 8.2 L1.59 8.01 L1.62 7.83 L1.7 7.66 L1.83 7.53 L1.98 7.45 L5.27 6.35 L7.66 1.86 L7.87 1.58 L8.02 1.43 L8.18 1.31 L8.41 1.17 L8.72 1.06 L9.05 1 L9.31 1.01 L9.64 1.06 L9.9 1.15 L10.14 1.29 L10.36 1.46 Z M6.04 7.03 L5.98 7.12 L5.81 7.22 L2.95 8.18 L7.83 13.06 L8.78 10.19 L8.88 10.04 L8.98 9.96 L13.65 7.46 L13.79 7.35 L13.89 7.21 L13.96 7.05 L13.99 6.89 L13.98 6.72 L13.95 6.58 L13.88 6.45 L13.79 6.33 L9.66 2.18 L9.54 2.09 L9.37 2.03 L9.2 2 L9.04 2.01 L8.87 2.06 L8.75 2.13 L8.62 2.25 L8.53 2.37 Z"
                        AutomationProperties.AccessibilityView="Raw"
                        Visibility="{Binding PinVisibility}" />
                    <TextBlock
                        Grid.Column="1"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding DisplayTitle}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    MaxLines="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding TagText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding TagVisibility}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    MaxLines="3"
                    AutomationProperties.AccessibilityView="Raw"
                    DataContextChanged="SearchResultText_DataContextChanged"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Excerpt}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding ExcerptVisibility}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="SearchPageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageMarginStates">
                <VisualState x:Name="WidePageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchPageHeader.Margin" Value="{StaticResource PageHeaderMargin}" />
                        <Setter Target="SearchInput.Margin" Value="{StaticResource PageControlMargin}" />
                        <Setter Target="SearchFilterBar.Margin" Value="{StaticResource PageControlMargin}" />
                        <Setter Target="ErrorInfoBar.Margin" Value="{StaticResource PageInfoBarMargin}" />
                        <Setter Target="SearchResultsArea.Margin" Value="{StaticResource PageContentMargin}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowPageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchPageHeader.Margin" Value="{StaticResource PageHeaderNarrowMargin}" />
                        <Setter Target="SearchInput.Margin" Value="{StaticResource PageControlNarrowMargin}" />
                        <Setter Target="SearchFilterBar.Margin" Value="{StaticResource PageControlNarrowMargin}" />
                        <Setter Target="ErrorInfoBar.Margin" Value="{StaticResource PageInfoBarNarrowMargin}" />
                        <Setter Target="SearchResultsArea.Margin" Value="{StaticResource PageContentNarrowMargin}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock
            x:Name="SearchPageHeader"
            x:Uid="SearchPageTitle"
            Margin="{StaticResource PageHeaderMargin}"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Search" />

        <muxc:AutoSuggestBox
            x:Name="SearchInput"
            x:Uid="SearchPageInput"
            Grid.Row="1"
            Margin="{StaticResource PageControlMargin}"
            MaxWidth="720"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="Search notes"
            PlaceholderText="Search notes..."
            QuerySubmitted="SearchInput_QuerySubmitted"
            TextChanged="SearchInput_TextChanged">
            <muxc:AutoSuggestBox.QueryIcon>
                <!-- Fluent UI System Icons: search_16_regular; ink 13.00 x 13.00 -> 14.00 px long edge, centered on 16; 1 px bands after the 1 px correction. Source: fluentui-system-icons main (official SVG). -->
                <muxc:PathIcon
                    Width="16"
                    Height="16"
                    Data="F1 M10.71 11.47 L10.25 11.83 L9.74 12.13 L9.21 12.39 L8.73 12.56 L8.15 12.72 L7.63 12.8 L7.1 12.84 L6.52 12.83 L5.92 12.76 L5.35 12.63 L4.8 12.45 L4.27 12.22 L3.77 11.94 L3.3 11.61 L2.87 11.24 L2.48 10.84 L2.12 10.39 L1.81 9.91 L1.54 9.4 L1.33 8.87 L1.16 8.31 L1.05 7.73 L1 7.13 L1.01 6.52 L1.08 5.92 L1.21 5.35 L1.39 4.8 L1.63 4.27 L1.91 3.77 L2.23 3.3 L2.6 2.87 L3.01 2.48 L3.46 2.12 L3.93 1.81 L4.44 1.54 L4.98 1.33 L5.54 1.16 L6.12 1.05 L6.72 1 L7.33 1.01 L7.92 1.08 L8.5 1.21 L9.05 1.39 L9.58 1.63 L10.08 1.91 L10.54 2.23 L10.98 2.6 L11.37 3.01 L11.73 3.46 L12.04 3.93 L12.3 4.44 L12.45 4.8 L12.63 5.35 L12.76 5.92 L12.83 6.52 L12.85 6.92 L12.82 7.46 L12.75 7.98 L12.64 8.49 L12.48 8.97 L12.29 9.44 L12.05 9.89 L11.78 10.31 L11.47 10.71 L14.84 14.08 L14.92 14.18 L14.99 14.36 L14.99 14.55 L14.93 14.73 L14.8 14.88 L14.63 14.97 L14.43 15 L14.24 14.95 L14.08 14.84 Z M11.83 6.59 L11.78 6.09 L11.67 5.61 L11.52 5.16 L11.33 4.72 L11.09 4.3 L10.82 3.91 L10.51 3.56 L10.17 3.23 L9.81 2.93 L9.41 2.67 L8.99 2.45 L8.54 2.27 L8.07 2.14 L7.59 2.04 L7.09 2 L6.59 2.01 L6.09 2.07 L5.61 2.18 L5.16 2.33 L4.72 2.52 L4.3 2.75 L3.91 3.03 L3.56 3.33 L3.23 3.67 L2.93 4.04 L2.67 4.44 L2.45 4.86 L2.27 5.31 L2.14 5.77 L2.04 6.26 L2 6.75 L2.01 7.26 L2.07 7.75 L2.18 8.23 L2.33 8.69 L2.52 9.13 L2.75 9.54 L3.03 9.93 L3.33 10.29 L3.67 10.62 L4.04 10.91 L4.44 11.17 L4.86 11.39 L5.31 11.57 L5.77 11.71 L6.26 11.8 L6.75 11.84 L7.26 11.83 L7.75 11.78 L8.23 11.67 L8.69 11.52 L9.13 11.33 L9.54 11.09 L9.93 10.82 L10.29 10.51 L10.62 10.17 L10.91 9.81 L11.17 9.41 L11.39 8.99 L11.57 8.54 L11.71 8.07 L11.8 7.59 L11.84 7.09 Z"
                    AutomationProperties.AccessibilityView="Raw" />
            </muxc:AutoSuggestBox.QueryIcon>
        </muxc:AutoSuggestBox>

        <ScrollViewer
            x:Name="SearchFilterBar"
            Grid.Row="2"
            Margin="{StaticResource PageControlMargin}"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="SearchTagFilter"
                    x:Uid="SearchTagFilter"
                    MinWidth="130"
                    AutomationProperties.Name="Tag filter"
                    SelectionChanged="SearchFilter_Changed" />
                <ComboBox
                    x:Name="SearchFolderFilter"
                    x:Uid="SearchFolderFilter"
                    MinWidth="130"
                    AutomationProperties.Name="Folder filter"
                    SelectionChanged="SearchFilter_Changed" />
                <ComboBox
                    x:Name="SearchDateFilter"
                    x:Uid="SearchDateFilter"
                    MinWidth="130"
                    AutomationProperties.Name="Date filter"
                    SelectionChanged="SearchFilter_Changed" />
                <CheckBox
                    x:Name="SearchTitleOnly"
                    VerticalAlignment="Center"
                    Checked="SearchTitleOnly_Changed"
                    Content="Title only"
                    Unchecked="SearchTitleOnly_Changed" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3">
            <TextBlock
                x:Name="IndexNoticeTextBlock"
                Margin="{StaticResource PageInfoBarMargin}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <muxc:InfoBar
                x:Name="ErrorInfoBar"
                x:Uid="SearchErrorBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error">
                <muxc:InfoBar.ActionButton>
                    <Button
                        x:Name="RetryButton"
                        x:Uid="SearchRetryButton"
                        Click="RetryButton_Click"
                        Content="Retry" />
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>

            <TextBlock
                x:Name="ProgressTextBlock"
                Margin="{StaticResource PageInfoBarMargin}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid
            x:Name="SearchResultsArea"
            Grid.Row="4"
            Margin="{StaticResource PageContentMargin}"
            MaxWidth="960"
            HorizontalAlignment="Stretch">
            <ListView
                x:Name="ResultsList"
                x:Uid="SearchResultsList"
                AutomationProperties.Name="Search results"
                IsItemClickEnabled="True"
                ItemClick="ResultsList_ItemClick"
                KeyDown="ResultsList_KeyDown"
                ItemContainerTransitions="{x:Null}"
                ItemTemplate="{StaticResource SearchResultTemplate}"
                ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                SelectionMode="None"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="EmptyText"
                x:Uid="SearchPageEmpty"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Type a keyword to search your notes."
                TextWrapping="Wrap" />
            <muxc:ProgressRing
                x:Name="LoadingRing"
                x:Uid="SearchPageLoading"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading notes"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
