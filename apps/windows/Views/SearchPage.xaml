<Page
    x:Class="NopeNote.Windows.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="SearchPageTitle"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="Search" />

        <muxc:AutoSuggestBox
            x:Name="SearchInput"
            x:Uid="SearchPageInput"
            Grid.Row="1"
            Margin="0,12,0,12"
            AutomationProperties.Name="Search notes"
            PlaceholderText="Search notes..."
            QueryIcon="Find"
            QuerySubmitted="SearchInput_QuerySubmitted"
            TextChanged="SearchInput_TextChanged" />

        <Grid Grid.Row="2">
            <ListView
                x:Name="ResultsList"
                IsItemClickEnabled="True"
                ItemClick="ResultsList_ItemClick"
                ItemTemplate="{StaticResource NoteItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Notes}"
                SelectionMode="None"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="EmptyText"
                x:Uid="SearchPageEmpty"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Type a keyword to search your notes."
                TextWrapping="Wrap" />
            <muxc:ProgressRing
                x:Name="LoadingRing"
                x:Uid="SearchPageLoading"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading notes"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
