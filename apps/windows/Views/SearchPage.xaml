<Page
    x:Class="NopeNote.Windows.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="SearchPageTitle"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Search" />

        <muxc:AutoSuggestBox
            x:Name="SearchInput"
            x:Uid="SearchPageInput"
            Grid.Row="1"
            Margin="0,12,0,12"
            AutomationProperties.Name="Search notes"
            PlaceholderText="Search notes..."
            QuerySubmitted="SearchInput_QuerySubmitted"
            TextChanged="SearchInput_TextChanged">
            <muxc:AutoSuggestBox.QueryIcon>
                <muxc:PathIcon
                    Width="20"
                    Height="20"
                    Data="M13.73 14.44a6.5 6.5 0 1 1 .7-.7l3.42 3.4a.5.5 0 0 1-.63.77l-.07-.06zm-.71-.71A5.5 5.5 0 0 0 15 9.5a5.5 5.5 0 1 0-1.98 4.23"
                    AutomationProperties.AccessibilityView="Raw" />
            </muxc:AutoSuggestBox.QueryIcon>
        </muxc:AutoSuggestBox>

        <muxc:InfoBar
            x:Name="ErrorInfoBar"
            x:Uid="SearchErrorBar"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Error">
            <muxc:InfoBar.ActionButton>
                <Button
                    x:Name="RetryButton"
                    x:Uid="SearchRetryButton"
                    Click="RetryButton_Click"
                    Content="Retry" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>

        <Grid Grid.Row="3">
            <ListView
                x:Name="ResultsList"
                x:Uid="SearchResultsList"
                AutomationProperties.Name="Search results"
                IsItemClickEnabled="True"
                ItemClick="ResultsList_ItemClick"
                ItemTemplate="{StaticResource NoteItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Notes}"
                SelectionMode="None"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="EmptyText"
                x:Uid="SearchPageEmpty"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Type a keyword to search your notes."
                TextWrapping="Wrap" />
            <muxc:ProgressRing
                x:Name="LoadingRing"
                x:Uid="SearchPageLoading"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading notes"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
