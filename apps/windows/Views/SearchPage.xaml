<Page
    x:Class="NopeNote.Windows.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <DataTemplate x:Key="SearchResultTemplate">
            <Grid Padding="{StaticResource NoteItemPadding}" AutomationProperties.Name="{Binding DisplayTitle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xE840;"
                        AutomationProperties.AccessibilityView="Raw"
                        Visibility="{Binding PinVisibility}" />
                    <TextBlock
                        Grid.Column="1"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding DisplayTitle}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    MaxLines="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding TagText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding TagVisibility}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    MaxLines="3"
                    AutomationProperties.AccessibilityView="Raw"
                    DataContextChanged="SearchResultText_DataContextChanged"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Text}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="SearchPageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageMarginStates">
                <VisualState x:Name="WidePageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchPageHeader.Margin" Value="{StaticResource PageHeaderMargin}" />
                        <Setter Target="SearchInput.Margin" Value="{StaticResource PageControlMargin}" />
                        <Setter Target="ErrorInfoBar.Margin" Value="{StaticResource PageInfoBarMargin}" />
                        <Setter Target="SearchResultsArea.Margin" Value="{StaticResource PageContentMargin}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowPageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchPageHeader.Margin" Value="{StaticResource PageHeaderNarrowMargin}" />
                        <Setter Target="SearchInput.Margin" Value="{StaticResource PageControlNarrowMargin}" />
                        <Setter Target="ErrorInfoBar.Margin" Value="{StaticResource PageInfoBarNarrowMargin}" />
                        <Setter Target="SearchResultsArea.Margin" Value="{StaticResource PageContentNarrowMargin}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock
            x:Name="SearchPageHeader"
            x:Uid="SearchPageTitle"
            Margin="{StaticResource PageHeaderMargin}"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Search" />

        <muxc:AutoSuggestBox
            x:Name="SearchInput"
            x:Uid="SearchPageInput"
            Grid.Row="1"
            Margin="{StaticResource PageControlMargin}"
            MaxWidth="720"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="Search notes"
            PlaceholderText="Search notes..."
            QuerySubmitted="SearchInput_QuerySubmitted"
            TextChanged="SearchInput_TextChanged">
            <muxc:AutoSuggestBox.QueryIcon>
                <!-- Fluent UI System Icons: search_16_regular; ink 13.55 x 13.54 -> 14.00 px long edge, centered on 16. Source 1 px bands scale with the correction. -->
                <muxc:PathIcon
                    Width="16"
                    Height="16"
                    Data="F1 M10.888 11.616A5.684 5.684 0 1 1 11.611 10.893L14.846 14.117A0.517 0.517 0 0 1 14.122 14.841ZM11.9 7.245A4.651 4.651 0 1 0 2.599 7.245 4.651 4.651 0 0 0 11.9 7.245"
                    AutomationProperties.AccessibilityView="Raw" />
            </muxc:AutoSuggestBox.QueryIcon>
        </muxc:AutoSuggestBox>

        <muxc:InfoBar
            x:Name="ErrorInfoBar"
            x:Uid="SearchErrorBar"
            Grid.Row="2"
            Margin="{StaticResource PageInfoBarMargin}"
            IsClosable="False"
            IsOpen="False"
            Severity="Error">
            <muxc:InfoBar.ActionButton>
                <Button
                    x:Name="RetryButton"
                    x:Uid="SearchRetryButton"
                    Click="RetryButton_Click"
                    Content="Retry" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>

        <Grid
            x:Name="SearchResultsArea"
            Grid.Row="3"
            Margin="{StaticResource PageContentMargin}"
            MaxWidth="960"
            HorizontalAlignment="Stretch">
            <ListView
                x:Name="ResultsList"
                x:Uid="SearchResultsList"
                AutomationProperties.Name="Search results"
                IsItemClickEnabled="True"
                ItemClick="ResultsList_ItemClick"
                ItemContainerTransitions="{x:Null}"
                ItemTemplate="{StaticResource SearchResultTemplate}"
                ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                SelectionMode="None"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="EmptyText"
                x:Uid="SearchPageEmpty"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Type a keyword to search your notes."
                TextWrapping="Wrap" />
            <muxc:ProgressRing
                x:Name="LoadingRing"
                x:Uid="SearchPageLoading"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading notes"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
