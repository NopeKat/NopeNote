<Page
    x:Class="NopeNote.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="{StaticResource SettingsSectionHeaderMargin}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="SettingsPageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageMarginStates">
                <VisualState x:Name="WidePageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsHeader.Margin" Value="{StaticResource PageHeaderMargin}" />
                        <Setter Target="SettingsContentGrid.Padding" Value="{StaticResource PageContentMargin}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowPageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsHeader.Margin" Value="{StaticResource PageHeaderNarrowMargin}" />
                        <Setter Target="SettingsContentGrid.Padding" Value="{StaticResource PageContentNarrowMargin}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock
            x:Name="SettingsHeader"
            x:Uid="SettingsHeader"
            MaxWidth="{StaticResource SettingsPageMaxWidth}"
            Margin="{StaticResource PageHeaderMargin}"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Settings" />

        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Grid x:Name="SettingsContentGrid" Padding="{StaticResource PageContentMargin}">
                <Border>
                    <StackPanel
                        MaxWidth="{StaticResource SettingsPageMaxWidth}"
                        Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock
                        x:Uid="SettingsSectionAppearanceLanguage"
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="Appearance &amp; language" />

