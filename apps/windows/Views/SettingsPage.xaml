                                AutomationProperties.AccessibilityView="Raw" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="ThemeModeComboBox"
                            x:Uid="SettingsThemeComboBox"
                            AutomationProperties.AutomationId="themeModeComboBox"
                            AutomationProperties.Name="App theme"
                            SelectionChanged="ThemeMode_SelectionChanged">
                            <ComboBoxItem x:Uid="ThemeLight" Content="Light" Tag="Light" />
                            <ComboBoxItem x:Uid="ThemeDark" Content="Dark" Tag="Dark" />
                            <ComboBoxItem x:Uid="ThemeSystem" Content="Use system setting" Tag="Default" />
                        </ComboBox>
                    </toolkit:SettingsCard>

