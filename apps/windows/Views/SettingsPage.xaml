                            x:Uid="GitToggle"
                            AutomationProperties.Name="Version history"
                            Toggled="GitToggle_Toggled" />
                    </toolkit:SettingsCard>

                    <TextBlock
                        x:Uid="SettingsSectionAbout"
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="About" />
                    <toolkit:SettingsExpander x:Name="AboutExpander">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <!-- Fluent UI System Icons: question_24_regular; ink 10.27 x 17.00 -> 18.75 px long edge, centered on 20. Source 1 px bands scale with the correction. -->
                            <PathIcon
                                Width="20"
                                Height="20"
                                Data="F1 M9.85 0.627A5.514 5.514 0 0 0 4.335 6.141 0.827 0.827 0 0 0 5.99 6.141 3.86 3.86 0 1 1 13.709 6.141C13.709 7.078 13.467 7.707 13.125 8.192A6.617 6.617 0 0 1 11.537 9.67C10.434 10.519 9.022 11.578 9.022 13.861V14.137A0.827 0.827 0 0 0 10.677 14.137V13.861C10.677 12.405 11.46 11.81 12.651 10.905L12.695 10.861C13.279 10.42 13.963 9.891 14.481 9.141A5.514 5.514 0 0 0 9.85 0.627M9.85 19.375A1.103 1.103 0 1 0 9.85 17.169 1.103 1.103 0 0 0 9.85 19.375"
