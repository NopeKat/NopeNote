                        </toolkit:SettingsCard.HeaderIcon>
                        <Button
                            x:Uid="ChangeVaultButton"
                            AutomationProperties.Name="Change vault folder"
                            Click="ChangeVaultButton_Click"
                            Content="Change folder" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Name="VersionHistoryCard">
                        <toolkit:SettingsCard.HeaderIcon>
                            <!-- Fluent UI System Icons: history_20_regular; ink 14.75 x 15.20 -> 17.50 px long edge, centered on 20. Source 1 px bands scale with the correction. -->
                            <PathIcon
                                Width="20"
                                Height="20"
                                Data="F1 M9.571 3.194A6.908 6.908 0 1 1 2.686 9.572 0.576 0.576 0 1 0 1.535 9.48L1.512 10.102A8.059 8.059 0 1 0 3.815 4.46V2.618A0.576 0.576 0 0 0 2.663 2.618V6.072C2.663 6.395 2.917 6.648 3.239 6.648H6.693A0.576 0.576 0 0 0 6.693 5.497H4.425C5.691 4.08 7.533 3.194 9.571 3.194M9.571 6.072A0.576 0.576 0 0 0 8.42 6.072V10.677C8.42 11 8.673 11.253 8.995 11.253H12.449A0.576 0.576 0 0 0 12.449 10.102H9.571Z"
