                        <ComboBox
                            x:Name="LanguageModeComboBox"
                            x:Uid="SettingsLanguageComboBox"
                            AutomationProperties.AutomationId="languageModeComboBox"
                            AutomationProperties.Name="Language"
                            SelectionChanged="LanguageMode_SelectionChanged">
                            <ComboBoxItem x:Uid="LanguageSystem" Content="Use system setting" Tag="" />
                            <ComboBoxItem x:Uid="LanguageEnglish" Content="English (United States)" Tag="en-US" />
                            <ComboBoxItem x:Uid="LanguageChinese" Content="中文（简体）" Tag="zh-Hans" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <TextBlock
                        x:Uid="SettingsSectionDataHistory"
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="Data &amp; history" />
