                        <TextBlock
                            x:Name="NoteSizeNoticeTextBlock"
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <TextBox
                            x:Name="NoteEditor"
                            Grid.Row="2"
                            x:Uid="NoteEditor"
                            AcceptsReturn="True"
                            AllowDrop="True"
                            AutomationProperties.Name="Note text"
                            Background="Transparent"
                            BorderThickness="0"
                            DragOver="NoteEditor_DragOver"
                            Drop="NoteEditor_Drop"
                            IsEnabled="False"
                            LostFocus="NoteEditor_LostFocus"
                            PlaceholderText="Enter your note"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind SelectedNote.Text, Mode=TwoWay}"
                            TextChanged="NoteEditor_TextChanged"
                            TextWrapping="Wrap"
                            VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="PreviewCard"
                        Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PreviewPanel" Spacing="6" />
                        </ScrollViewer>
                    </Border>

                    <muxc:Expander
                        x:Name="BacklinksExpander"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        IsExpanded="False"
                        Visibility="Collapsed">
                        <muxc:Expander.Header>
                            <TextBlock x:Name="BacklinksHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </muxc:Expander.Header>
                        <ListView
                            x:Name="BacklinksList"
                            MaxHeight="140"
                            IsItemClickEnabled="True"
                            ItemClick="BacklinksList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="8,6,8,6"
                                        Text="{Binding DisplayTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </muxc:Expander>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
