<Page
    x:Class="NopeNote.Windows.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="using:Microsoft.UI.Xaml.Input"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Enabled">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="{StaticResource MasterDetailListPaneWidth}" />
            <ColumnDefinition x:Name="DetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutWidthStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MasterDetailBreakpointWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="{StaticResource MasterDetailListPaneWidth}" />
                        <Setter Target="DetailColumn.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="*" />
                        <Setter Target="DetailColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <muxc:InfoBar
            x:Name="ErrorInfoBar"
            x:Uid="NotesErrorBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            AutomationProperties.Name="Notes error"
            Closed="ErrorInfoBar_Closed"
            IsClosable="True"
            IsOpen="False"
            Severity="Error">
            <muxc:InfoBar.ActionButton>
                <Button
                    x:Name="ErrorRetryButton"
                    x:Uid="NotesRetryButton"
                    AutomationProperties.Name="Retry failed operation"
                    Click="ErrorRetryButton_Click"
                    Content="Retry" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>

        <TextBlock
            x:Name="NotesPageHeader"
            x:Uid="NotesCommandBarTitle"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="{StaticResource NotesPageHeaderMargin}"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Quick notes" />

        <muxc:CommandBar
            x:Name="NotesCommandBar"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            DefaultLabelPosition="Right">
            <muxc:AppBarButton
                x:Name="BackToListButton"
                x:Uid="NotesBackButton"
                AutomationProperties.Name="Back to notes list"
                Click="BackToListButton_Click"
                KeyboardAcceleratorPlacementMode="Auto"
                Label="Back"
                Visibility="Collapsed">
                <muxc:AppBarButton.Icon>
                    <muxc:PathIcon
                        Width="20"
                        Height="20"
                        Data="M9.16 16.87a.5.5 0 1 0 .67-.74L3.67 10.5H17.5a.5.5 0 0 0 0-1H3.67l6.16-5.63a.5.5 0 0 0-.67-.74L2.24 9.44a.75.75 0 0 0 0 1.11z"
                        AutomationProperties.AccessibilityView="Raw" />
                </muxc:AppBarButton.Icon>
            </muxc:AppBarButton>
            <muxc:AppBarButton
                x:Name="NewNoteButton"
                x:Uid="NotesNewButton"
                AutomationProperties.Name="New note"
                Click="NewNoteButton_Click"
                KeyboardAcceleratorPlacementMode="Auto"
                Label="New note">
                <muxc:AppBarButton.Icon>
                    <muxc:PathIcon
                        Width="20"
                        Height="20"
                        Data="M10 2.5c.28 0 .5.22.5.5v6.5H17a.5.5 0 0 1 0 1h-6.5V17a.5.5 0 0 1-1 0v-6.5H3a.5.5 0 0 1 0-1h6.5V3c0-.28.22-.5.5-.5"
                        AutomationProperties.AccessibilityView="Raw" />
                </muxc:AppBarButton.Icon>
                <muxc:AppBarButton.KeyboardAccelerators>
                    <input:KeyboardAccelerator Key="N" Modifiers="Control" />
                </muxc:AppBarButton.KeyboardAccelerators>
            </muxc:AppBarButton>
            <muxc:AppBarButton
                x:Name="DeleteNoteButton"
                x:Uid="NotesDeleteButton"
                AutomationProperties.Name="Delete note"
                Click="DeleteNoteButton_Click"
                IsEnabled="False"
                KeyboardAcceleratorPlacementMode="Auto"
                Label="Delete">
                <muxc:AppBarButton.Icon>
                    <muxc:PathIcon
                        Width="20"
                        Height="20"
                        Data="M8.5 4h3a1.5 1.5 0 0 0-3 0m-1 0a2.5 2.5 0 0 1 5 0h5a.5.5 0 0 1 0 1h-1.05l-1.2 10.34A3 3 0 0 1 12.27 18H7.73a3 3 0 0 1-2.98-2.66L3.55 5H2.5a.5.5 0 0 1 0-1zM5.74 15.23A2 2 0 0 0 7.73 17h4.54a2 2 0 0 0 1.99-1.77L15.44 5H4.56zM8.5 7.5c.28 0 .5.22.5.5v6a.5.5 0 0 1-1 0V8c0-.28.22-.5.5-.5M12 8a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"
                        AutomationProperties.AccessibilityView="Raw" />
                </muxc:AppBarButton.Icon>
                <muxc:AppBarButton.KeyboardAccelerators>
                    <input:KeyboardAccelerator Key="Delete" />
                </muxc:AppBarButton.KeyboardAccelerators>
            </muxc:AppBarButton>
        </muxc:CommandBar>

        <Grid
            x:Name="NotesListPanel"
            Grid.Row="3"
            Grid.Column="0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="{StaticResource NotesListBorderThickness}">
            <muxc:ProgressRing
                x:Name="NotesLoadingRing"
                x:Uid="NotesLoadingRing"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading notes"
                IsActive="False"
                Visibility="Collapsed" />
            <muxc:ItemsView
                x:Name="NotesItemsView"
                Margin="{StaticResource NotesListMargin}"
                IsItemInvokedEnabled="True"
                ItemInvoked="NotesItemsView_ItemInvoked"
                ItemTemplate="{StaticResource NoteItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Notes}"
                SelectionMode="Single">
                <muxc:ItemsView.Layout>
                    <muxc:UniformGridLayout
                        ItemsJustification="Start"
                        MinColumnSpacing="{StaticResource NotesItemSpacing}"
                        MinItemWidth="{StaticResource NotesItemMinWidth}"
                        MinRowSpacing="{StaticResource NotesItemSpacing}" />
                </muxc:ItemsView.Layout>
            </muxc:ItemsView>
            <TextBlock
                x:Name="EmptyStateTextBlock"
                x:Uid="NotesEmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="No notes yet. Select New note to create one."
                Visibility="Collapsed" />
        </Grid>

        <Grid
            x:Name="NoteDetailPanel"
            Grid.Row="3"
            Grid.Column="1"
            Padding="{StaticResource NotesDetailPanePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="NoteDateTextBlock"
                x:Uid="NotesDateHeader"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Select a note" />
            <StackPanel
                Grid.Row="1"
                Margin="{StaticResource NotesEditorMargin}"
                Spacing="{StaticResource NotesEditorSpacing}">
                <TextBox
                    x:Name="NoteEditor"
                    x:Uid="NoteEditor"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Note text"
                    IsEnabled="False"
                    LostFocus="NoteEditor_LostFocus"
                    PlaceholderText="Enter your note"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind SelectedNote.Text, Mode=TwoWay}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource StatusSpacing}">
                    <muxc:ProgressRing
                        x:Name="SaveProgressRing"
                        x:Uid="NotesSaveRing"
                        Width="{StaticResource InlineProgressRingSize}"
                        Height="{StaticResource InlineProgressRingSize}"
                        AutomationProperties.Name="Saving note"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="SaveStatusTextBlock"
                        x:Uid="NotesSaveStatus"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="Save status"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
