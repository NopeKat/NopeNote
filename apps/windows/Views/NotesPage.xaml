<Page
    x:Class="NopeNote.Windows.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:NopeNote.Windows.Models"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <DataTemplate x:Key="NoteItemTemplate" x:DataType="models:Note">
            <Grid Padding="12" AutomationProperties.Name="{x:Bind DisplayTitle, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    MaxLines="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind DisplayTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    MaxLines="2"
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Text, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="{StaticResource MasterDetailListPaneWidth}" />
            <ColumnDefinition x:Name="DetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutWidthStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MasterDetailBreakpointWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="{StaticResource MasterDetailListPaneWidth}" />
                        <Setter Target="DetailColumn.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="*" />
                        <Setter Target="DetailColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <muxc:CommandBar
            x:Name="NotesCommandBar"
            Grid.ColumnSpan="2"
            DefaultLabelPosition="Right">
            <muxc:AppBarButton
                x:Name="BackToListButton"
                AutomationProperties.Name="Back to notes list"
                Click="BackToListButton_Click"
                Icon="Back"
                Label="Back"
                Visibility="Collapsed" />
            <muxc:AppBarButton
                x:Name="NewNoteButton"
                AutomationProperties.Name="New note"
                Click="NewNoteButton_Click"
                Icon="Add"
                Label="New note" />
            <muxc:AppBarButton
                x:Name="DeleteNoteButton"
                AutomationProperties.Name="Delete note"
                Click="DeleteNoteButton_Click"
                Icon="Delete"
                IsEnabled="False"
                Label="Delete" />
            <muxc:CommandBar.Content>
                <TextBlock
                    Margin="16,8,0,8"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Quick notes" />
            </muxc:CommandBar.Content>
        </muxc:CommandBar>

        <Grid
            x:Name="NotesListPanel"
            Grid.Row="1"
            Grid.Column="0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <muxc:ItemsView
                x:Name="NotesItemsView"
                Margin="12"
                IsItemInvokedEnabled="True"
                ItemInvoked="NotesItemsView_ItemInvoked"
                ItemTemplate="{StaticResource NoteItemTemplate}"
                ItemsSource="{x:Bind ViewModel.Notes}"
                SelectionMode="Single">
                <muxc:ItemsView.Layout>
                    <muxc:UniformGridLayout
                        ItemsJustification="Start"
                        MinColumnSpacing="8"
                        MinItemWidth="280"
                        MinRowSpacing="8" />
                </muxc:ItemsView.Layout>
            </muxc:ItemsView>
            <TextBlock
                x:Name="EmptyStateTextBlock"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="No notes yet. Select New note to create one."
                Visibility="Collapsed" />
        </Grid>

        <Grid x:Name="NoteDetailPanel" Grid.Row="1" Grid.Column="1" Padding="24,12,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="NoteDateTextBlock"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Select a note" />
            <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
                <TextBox
                    x:Name="NoteEditor"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Note text"
                    Header="Note"
                    IsEnabled="False"
                    LostFocus="NoteEditor_LostFocus"
                    PlaceholderText="Enter your note"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind SelectedNote.Text, Mode=TwoWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SaveStatusTextBlock"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Save status"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
