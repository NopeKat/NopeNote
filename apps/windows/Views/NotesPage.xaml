                    <muxc:AppBarButton.KeyboardAccelerators>
                        <!-- Scoped to the note list so Delete still means "delete a character"
                             while the editor, search box or filters hold focus. -->
                        <input:KeyboardAccelerator
                            Key="Delete"
                            ScopeOwner="{x:Bind NotesItemsView}" />
                    </muxc:AppBarButton.KeyboardAccelerators>
                </muxc:AppBarButton>
            </muxc:CommandBar>

            <Grid
                x:Name="FilterBar"
                Grid.Row="2"
                Margin="12,0,12,8"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="TagFilterComboBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Filter notes by tag"
                    SelectionChanged="TagFilter_SelectionChanged" />
                <ComboBox
                    x:Name="FolderFilterComboBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Filter notes by folder"
                    SelectionChanged="FolderFilter_SelectionChanged" />
            </Grid>

            <ScrollViewer
                x:Name="BatchBar"
                Grid.Row="3"
                Margin="12,0,12,8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="BatchCountTextBlock"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button
                        x:Name="BatchTagButton"
                        Click="BatchTagButton_Click"
                        Content="Add tag" />
                    <Button
                        x:Name="BatchMoveButton"
                        Click="BatchFolderButton_Click"
                        Content="Move" />
                    <Button
                        x:Name="BatchDeleteButton"
                        Click="BatchDeleteButton_Click"
                        Content="Delete" />
                    <Button
                        x:Name="BatchDoneButton"
                        Click="BatchCancelButton_Click"
                        Content="Done" />
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="NotesListPanel"
                Grid.Row="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="{StaticResource NotesListBorderThickness}">
                <muxc:ProgressRing
                    x:Name="NotesLoadingRing"
                    x:Uid="NotesLoadingRing"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Loading notes"
                    IsActive="False"
                    Visibility="Collapsed" />
                <muxc:ItemsView
                    x:Name="NotesItemsView"
                    Margin="{StaticResource NotesListMargin}"
                    IsItemInvokedEnabled="True"
                    ItemInvoked="NotesItemsView_ItemInvoked"
                    ItemTemplate="{StaticResource NoteItemsViewItemTemplate}"
                    ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                    SelectionMode="Single">
                    <muxc:ItemsView.Layout>
                        <muxc:UniformGridLayout
                            ItemsJustification="Start"
                            MinColumnSpacing="{StaticResource NotesItemSpacing}"
                            MinItemWidth="{StaticResource NotesItemMinWidth}"
                            MinRowSpacing="{StaticResource NotesItemSpacing}" />
                    </muxc:ItemsView.Layout>
                </muxc:ItemsView>
                <TextBlock
                    x:Name="EmptyStateTextBlock"
                    x:Uid="NotesEmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="No notes yet. Select New note to create one."
                    Visibility="Collapsed" />
            </Grid>
