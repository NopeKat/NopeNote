<Page
    x:Class="NopeNote.Windows.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="using:Microsoft.UI.Xaml.Input"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Enabled">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageMarginStates">
                <VisualState x:Name="WidePageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NotesPageHeader.Margin" Value="{StaticResource PageHeaderMargin}" />
                        <Setter Target="NotesCommandBar.Margin" Value="{StaticResource PageCommandBarMargin}" />
                        <Setter Target="DetailHeader.Margin" Value="{StaticResource PageHeaderMargin}" />
                        <Setter Target="NoteMetaBar.Margin" Value="{StaticResource PageControlMargin}" />
                        <Setter Target="NoteDetailPanel.Padding" Value="{StaticResource NotesDetailPanePadding}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowPageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NotesPageHeader.Margin" Value="{StaticResource PageHeaderNarrowMargin}" />
                        <Setter Target="NotesCommandBar.Margin" Value="{StaticResource PageCommandBarNarrowMargin}" />
                        <Setter Target="DetailHeader.Margin" Value="{StaticResource PageHeaderNarrowMargin}" />
                        <Setter Target="NoteMetaBar.Margin" Value="{StaticResource PageControlNarrowMargin}" />
                        <Setter Target="NoteDetailPanel.Padding" Value="{StaticResource NotesDetailPaneNarrowPadding}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Grid.Row="0">
            <muxc:InfoBar
                x:Name="ErrorInfoBar"
                x:Uid="NotesErrorBar"
                Margin="{StaticResource PageInfoBarMargin}"
                AutomationProperties.Name="Notes error"
                Closed="ErrorInfoBar_Closed"
                IsClosable="True"
                IsOpen="False"
                Severity="Error">
                <muxc:InfoBar.ActionButton>
                    <Button
                        x:Name="ErrorRetryButton"
                        x:Uid="NotesRetryButton"
                        AutomationProperties.Name="Retry failed operation"
                        Click="ErrorRetryButton_Click"
                        Content="Retry" />
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>

            <Border
                x:Name="VaultNoticeBar"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="{StaticResource PageInfoBarMargin}"
                Padding="12,8"
                Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="VaultNoticeTitle"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="VaultNoticeMessage"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        x:Name="VaultNoticeDismiss"
                        Grid.Column="1"
                        AutomationProperties.Name="Dismiss the vault notice"
                        Click="VaultNoticeDismiss_Click"
                        VerticalAlignment="Top" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid x:Name="PanesGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="{StaticResource MasterDetailListPaneWidth}" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ListPane" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="NotesPageHeader"
                    x:Uid="NotesCommandBarTitle"
                    Grid.Row="0"
                    Margin="{StaticResource PageHeaderMargin}"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Quick notes" />

                <muxc:CommandBar
                    x:Name="NotesCommandBar"
                    Grid.Row="1"
                    Margin="{StaticResource PageCommandBarMargin}"
                    DefaultLabelPosition="Right">
                <muxc:AppBarButton
                    x:Name="NewNoteButton"
                    x:Uid="NotesNewButton"
                    AutomationProperties.Name="New note"
                    Click="NewNoteButton_Click"
                    KeyboardAcceleratorPlacementMode="Auto"
                    Label="New note">
                    <muxc:AppBarButton.Icon>
                        <!-- Fluent UI System Icons: add_16_regular; ink 12.00 x 12.00 -> 14.00 px long edge, centered on 16. Source 1 px bands scale with the correction. -->
                        <muxc:PathIcon
                            Width="16"
                            Height="16"
                            Data="F1 M8 1C8.327 1 8.583 1.257 8.583 1.583V7.417H14.417A0.583 0.583 0 0 1 14.417 8.583H8.583V14.417A0.583 0.583 0 0 1 7.417 14.417V8.583H1.583A0.583 0.583 0 0 1 1.583 7.417H7.417V1.583C7.417 1.257 7.673 1 8 1"
                            AutomationProperties.AccessibilityView="Raw" />
                    </muxc:AppBarButton.Icon>
                    <muxc:AppBarButton.KeyboardAccelerators>
                        <input:KeyboardAccelerator Key="N" Modifiers="Control" />
                    </muxc:AppBarButton.KeyboardAccelerators>
                </muxc:AppBarButton>
                <muxc:AppBarButton
                    x:Name="DailyNoteButton"
                    AutomationProperties.Name="Open today's note"
                    Click="DailyNoteButton_Click"
                    Label="Daily">
                    <muxc:AppBarButton.Icon>
                        <SymbolIcon Symbol="Calendar" />
                    </muxc:AppBarButton.Icon>
                </muxc:AppBarButton>
                <muxc:AppBarButton
                    x:Name="TemplateButton"
                    AutomationProperties.Name="New note from template"
                    Label="Template">
                    <muxc:AppBarButton.Icon>
                        <SymbolIcon Symbol="Page" />
                    </muxc:AppBarButton.Icon>
                    <muxc:AppBarButton.Flyout>
                        <MenuFlyout x:Name="TemplateMenu" Placement="Bottom" />
                    </muxc:AppBarButton.Flyout>
                </muxc:AppBarButton>
                <muxc:AppBarButton
                    x:Name="BatchButton"
                    AutomationProperties.Name="Select multiple notes"
                    Click="BatchButton_Click"
                    Label="Select">
                    <muxc:AppBarButton.Icon>
                        <SymbolIcon Symbol="SelectAll" />
                    </muxc:AppBarButton.Icon>
                </muxc:AppBarButton>
                <muxc:AppBarButton
                    x:Name="DeleteNoteButton"
                    x:Uid="NotesDeleteButton"
                    AutomationProperties.Name="Delete note"
                    Click="DeleteNoteButton_Click"
                    IsEnabled="False"
                    KeyboardAcceleratorPlacementMode="Auto"
                    Label="Delete">
                    <muxc:AppBarButton.Icon>
                        <!-- Fluent UI System Icons: delete_16_regular; ink 13.00 x 14.01 -> 14.00 px long edge, centered on 16. Source 1 px bands scale with the correction. -->
                        <muxc:PathIcon
                            Width="16"
                            Height="16"
                            Data="F1 M7.001 2.998H8.999A0.999 0.999 0 0 0 7.001 2.998M6.002 2.998A1.998 1.998 0 1 1 9.998 2.998H13.995A0.5 0.5 0 0 1 13.995 3.997H13.435L12.236 12.83A2.498 2.498 0 0 1 9.739 14.988H6.241A2.498 2.498 0 0 1 3.764 12.83L2.575 3.997H2.005A0.5 0.5 0 0 1 2.005 2.998ZM7.001 6.495A0.5 0.5 0 0 0 6.002 6.495V11.491A0.5 0.5 0 0 0 7.001 11.491ZM9.499 5.996C9.779 5.996 9.998 6.216 9.998 6.495V11.491A0.5 0.5 0 0 1 8.999 11.491V6.495C8.999 6.216 9.219 5.996 9.499 5.996M4.763 12.69C4.863 13.44 5.502 13.989 6.251 13.989H9.749A1.499 1.499 0 0 0 11.247 12.69L12.416 3.997H3.574Z"
                            AutomationProperties.AccessibilityView="Raw" />
                    </muxc:AppBarButton.Icon>
                    <muxc:AppBarButton.KeyboardAccelerators>
                        <input:KeyboardAccelerator Key="Delete" />
                    </muxc:AppBarButton.KeyboardAccelerators>
                </muxc:AppBarButton>
            </muxc:CommandBar>

            <Grid
                x:Name="FilterBar"
                Grid.Row="2"
                Margin="12,0,12,8"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="TagFilterComboBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Filter notes by tag"
                    SelectionChanged="TagFilter_SelectionChanged" />
                <ComboBox
                    x:Name="FolderFilterComboBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Filter notes by folder"
                    SelectionChanged="FolderFilter_SelectionChanged" />
            </Grid>

            <ScrollViewer
                x:Name="BatchBar"
                Grid.Row="3"
                Margin="12,0,12,8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="BatchCountTextBlock"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button
                        x:Name="BatchTagButton"
                        Click="BatchTagButton_Click"
                        Content="Add tag" />
                    <Button
                        x:Name="BatchMoveButton"
                        Click="BatchFolderButton_Click"
                        Content="Move" />
                    <Button
                        x:Name="BatchDeleteButton"
                        Click="BatchDeleteButton_Click"
                        Content="Delete" />
                    <Button
                        x:Name="BatchDoneButton"
                        Click="BatchCancelButton_Click"
                        Content="Done" />
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="NotesListPanel"
                Grid.Row="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="{StaticResource NotesListBorderThickness}">
                <muxc:ProgressRing
                    x:Name="NotesLoadingRing"
                    x:Uid="NotesLoadingRing"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Loading notes"
                    IsActive="False"
                    Visibility="Collapsed" />
                <muxc:ItemsView
                    x:Name="NotesItemsView"
                    Margin="{StaticResource NotesListMargin}"
                    IsItemInvokedEnabled="True"
                    ItemInvoked="NotesItemsView_ItemInvoked"
                    ItemTemplate="{StaticResource NoteItemsViewItemTemplate}"
                    ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                    SelectionMode="Single">
                    <muxc:ItemsView.Layout>
                        <muxc:UniformGridLayout
                            ItemsJustification="Start"
                            MinColumnSpacing="{StaticResource NotesItemSpacing}"
                            MinItemWidth="{StaticResource NotesItemMinWidth}"
                            MinRowSpacing="{StaticResource NotesItemSpacing}" />
                    </muxc:ItemsView.Layout>
                </muxc:ItemsView>
                <TextBlock
                    x:Name="EmptyStateTextBlock"
                    x:Uid="NotesEmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="No notes yet. Select New note to create one."
                    Visibility="Collapsed" />
            </Grid>
            </Grid>

            <Grid x:Name="DetailPane" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="DetailHeader" Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <muxc:AppBarButton
                        x:Name="BackToListButton"
                        x:Uid="NotesBackButton"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Back to notes list"
                        Click="BackToListButton_Click"
                        KeyboardAcceleratorPlacementMode="Auto"
                        Label="Back"
                        Visibility="Collapsed">
                        <muxc:AppBarButton.Icon>
                            <!-- Fluent UI System Icons: arrow_left_16_regular; ink 11.99 x 10.15 -> 14.00 px long edge, centered on 16. Source 1 px bands scale with the correction. -->
                            <muxc:PathIcon
                                Width="16"
                                Height="16"
                                Data="F1 M14.416 8.584A0.584 0.584 0 0 0 14.416 7.416H3.094L7.798 3.179A0.584 0.584 0 1 0 7.027 2.315L1.191 7.568A0.584 0.584 0 0 0 1.191 8.432L7.027 13.685A0.584 0.584 0 1 0 7.798 12.821L3.094 8.584Z"
                                AutomationProperties.AccessibilityView="Raw" />
                        </muxc:AppBarButton.Icon>
                    </muxc:AppBarButton>

                    <TextBlock
                        x:Name="NoteDateTextBlock"
                        x:Uid="NotesDateHeader"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Select a note"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource StatusSpacing}">
                        <muxc:AppBarButton
                            x:Name="ShareButton"
                            AutomationProperties.Name="Share or export this note"
                            Label="Share"
                            Visibility="Collapsed">
                            <muxc:AppBarButton.Icon>
                                <SymbolIcon Symbol="Share" />
                            </muxc:AppBarButton.Icon>
                            <muxc:AppBarButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem
                                        x:Name="ExportMarkdownItem"
                                        Click="ExportMarkdownButton_Click"
                                        Text="Export Markdown" />
                                    <MenuFlyoutItem
                                        x:Name="ExportHtmlItem"
                                        Click="ExportHtmlButton_Click"
                                        Text="Export HTML" />
                                    <MenuFlyoutItem
                                        x:Name="CopyNoteItem"
                                        Click="CopyNoteButton_Click"
                                        Text="Copy text" />
                                </MenuFlyout>
                            </muxc:AppBarButton.Flyout>
                        </muxc:AppBarButton>
                        <muxc:AppBarButton
                            x:Name="OpenWindowButton"
                            AutomationProperties.Name="Open this note in a new window"
                            Click="OpenWindowButton_Click"
                            Label="Window"
                            Visibility="Collapsed">
                            <muxc:AppBarButton.Icon>
                                <muxc:FontIcon FontSize="16" Glyph="&#xE8A7;" />
                            </muxc:AppBarButton.Icon>
                        </muxc:AppBarButton>
                        <muxc:AppBarToggleButton
                            x:Name="PreviewToggle"
                            AutomationProperties.Name="Toggle Markdown preview"
                            Click="PreviewToggle_Click"
                            Label="Preview"
                            Visibility="Collapsed">
                            <muxc:AppBarToggleButton.Icon>
                                <muxc:FontIcon FontSize="16" Glyph="&#xE890;" />
                            </muxc:AppBarToggleButton.Icon>
                        </muxc:AppBarToggleButton>
                        <muxc:AppBarButton
                            x:Name="HistoryButton"
                            Click="HistoryButton_Click"
                            Label="History"
                            Visibility="Collapsed">
                            <muxc:AppBarButton.Icon>
                                <!-- Symbol 枚举没有 History，用 Segoe Fluent Icons 的 history 字形（E81C，16 px）。 -->
                                <muxc:FontIcon FontSize="16" Glyph="&#xE81C;" />
                            </muxc:AppBarButton.Icon>
                        </muxc:AppBarButton>
                        <muxc:ProgressRing
                            x:Name="SaveProgressRing"
                            x:Uid="NotesSaveRing"
                            Width="{StaticResource InlineProgressRingSize}"
                            Height="{StaticResource InlineProgressRingSize}"
                            AutomationProperties.Name="Saving note"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="SaveStatusTextBlock"
                            x:Uid="NotesSaveStatus"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.Name="Save status"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="" />
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="NoteMetaBar"
                    Grid.Row="1"
                    Margin="{StaticResource PageControlMargin}"
                    ColumnSpacing="12"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="TagsEditor"
                        AutomationProperties.Name="Note tags"
                        LostFocus="TagsEditor_LostFocus"
                        PlaceholderText="Tags, separated by commas" />
                    <ComboBox
                        x:Name="FolderEditor"
                        Grid.Column="1"
                        AutomationProperties.Name="Note folder"
                        IsEditable="True"
                        LostFocus="FolderEditor_LostFocus"
                        SelectionChanged="FolderEditor_SelectionChanged" />
                    <CheckBox
                        x:Name="PinCheckBox"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Pin note"
                        Click="PinCheckBox_Click"
                        Content="Pin" />
                </Grid>

                <Grid
                    x:Name="NoteDetailPanel"
                    Grid.Row="2"
                    Padding="{StaticResource NotesDetailPanePadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="NoteEditorCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ScrollViewer
                                x:Name="MarkdownToolbar"
                                Margin="0,0,0,8"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button
                                    Click="BoldButton_Click"
                                    Content="B"
                                    FontWeight="SemiBold"
                                    ToolTipService.ToolTip="Bold" />
                                <Button
                                    Click="ItalicButton_Click"
                                    Content="I"
                                    FontStyle="Italic"
                                    ToolTipService.ToolTip="Italic" />
                                <Button
                                    Click="HeadingButton_Click"
                                    Content="H2"
                                    ToolTipService.ToolTip="Heading" />
                                <Button
                                    Click="BulletButton_Click"
                                    Content="•"
                                    ToolTipService.ToolTip="Bulleted list" />
                                <Button
                                    Click="ChecklistButton_Click"
                                    Content="☑"
                                    ToolTipService.ToolTip="Checklist" />
                                <Button
                                    Click="CodeButton_Click"
                                    Content="&lt;/&gt;"
                                    ToolTipService.ToolTip="Inline code" />
                                <Button
                                    Click="TableButton_Click"
                                    Content="▦"
                                    ToolTipService.ToolTip="Insert table" />
                                <Button
                                    Click="LinkButton_Click"
                                    Content="[["
                                    ToolTipService.ToolTip="Link a note" />
                                </StackPanel>
                            </ScrollViewer>

                        <TextBox
                            x:Name="NoteEditor"
                            Grid.Row="1"
                            x:Uid="NoteEditor"
                            AcceptsReturn="True"
                            AllowDrop="True"
                            AutomationProperties.Name="Note text"
                            Background="Transparent"
                            BorderThickness="0"
                            DragOver="NoteEditor_DragOver"
                            Drop="NoteEditor_Drop"
                            IsEnabled="False"
                            LostFocus="NoteEditor_LostFocus"
                            PlaceholderText="Enter your note"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind SelectedNote.Text, Mode=TwoWay}"
                            TextChanged="NoteEditor_TextChanged"
                            TextWrapping="Wrap"
                            VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="PreviewCard"
                        Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PreviewPanel" Spacing="6" />
                        </ScrollViewer>
                    </Border>

                    <muxc:Expander
                        x:Name="BacklinksExpander"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        IsExpanded="False"
                        Visibility="Collapsed">
                        <muxc:Expander.Header>
                            <TextBlock x:Name="BacklinksHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </muxc:Expander.Header>
                        <ListView
                            x:Name="BacklinksList"
                            MaxHeight="140"
                            IsItemClickEnabled="True"
                            ItemClick="BacklinksList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="8,6,8,6"
                                        Text="{Binding DisplayTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </muxc:Expander>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
