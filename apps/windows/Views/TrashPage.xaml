<Page
    x:Class="NopeNote.Windows.Views.TrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Enabled">

    <Grid x:Name="TrashPageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageMarginStates">
                <VisualState x:Name="WidePageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TrashPageHeader.Margin" Value="{StaticResource PageHeaderMargin}" />
                        <Setter Target="StatusInfoBar.Margin" Value="{StaticResource PageInfoBarMargin}" />
                        <Setter Target="TrashActions.Margin" Value="{StaticResource PageActionMargin}" />
                        <Setter Target="TrashContent.Margin" Value="{StaticResource PageContentMargin}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowPageMargins">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TrashPageHeader.Margin" Value="{StaticResource PageHeaderNarrowMargin}" />
                        <Setter Target="StatusInfoBar.Margin" Value="{StaticResource PageInfoBarNarrowMargin}" />
                        <Setter Target="TrashActions.Margin" Value="{StaticResource PageActionNarrowMargin}" />
                        <Setter Target="TrashContent.Margin" Value="{StaticResource PageContentNarrowMargin}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock
            x:Name="TrashPageHeader"
            x:Uid="TrashHeader"
            Margin="{StaticResource PageHeaderMargin}"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Trash" />

        <muxc:InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="{StaticResource PageInfoBarMargin}"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning" />

        <StackPanel
            x:Name="TrashActions"
            Grid.Row="2"
            Margin="{StaticResource PageActionMargin}"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="RestoreButton"
                x:Uid="RestoreButton"
                AutomationProperties.Name="Restore note"
                Click="RestoreButton_Click"
                Content="Restore"
                IsEnabled="False" />
            <Button
                x:Name="PurgeButton"
                x:Uid="PurgeButton"
                AutomationProperties.Name="Delete selected notes permanently"
                Click="PurgeButton_Click"
                Content="Delete permanently"
                IsEnabled="False" />
            <Button
                x:Name="EmptyTrashButton"
                x:Uid="TrashEmptyButton"
                AutomationProperties.Name="Empty the trash"
                Click="EmptyTrashButton_Click"
                Content="Empty trash"
                IsEnabled="False" />
        </StackPanel>

        <Grid x:Name="TrashContent" Grid.Row="3" Margin="{StaticResource PageContentMargin}">
            <ListView
                x:Name="TrashList"
                x:Uid="TrashList"
                AutomationProperties.Name="Trashed notes"
                ItemContainerTransitions="{x:Null}"
                SelectionChanged="TrashList_SelectionChanged"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8" Spacing="2">
                            <TextBlock
                                MaxLines="1"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding Details}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <muxc:ProgressRing
                x:Name="LoadingRing"
                x:Uid="TrashLoadingRing"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading trash"
                IsActive="False"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock
                    x:Uid="TrashEmptyState"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="The trash is empty." />
                <Button
                    x:Uid="TrashOpenNotesButton"
                    AutomationProperties.Name="Open the notes list"
                    Click="OpenNotesButton_Click"
                    Content="Open notes" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
