<Window
    x:Class="NopeNote.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="using:Microsoft.UI.Xaml.Input"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid
        x:Name="RootGrid"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="RootGrid_Loaded">
        <Grid.KeyboardAccelerators>
            <input:KeyboardAccelerator
                Key="F"
                Invoked="SearchAccelerator_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏只保留图标与应用名，导航与搜索入口由侧栏承担 -->
        <muxc:TitleBar
            x:Name="AppTitleBar"
            Title="NopeNote"
            IsBackButtonVisible="False">
            <muxc:TitleBar.IconSource>
                <muxc:ImageIconSource ImageSource="/Assets/Tiles/NopeNoteIcon.ico" />
            </muxc:TitleBar.IconSource>
        </muxc:TitleBar>

        <Grid x:Name="AutomationHelpersPanel" Grid.Row="1">
            <Grid.Resources>
                <Style x:Key="AutomationHelperStyle" TargetType="Control">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Width" Value="0" />
                    <Setter Property="Height" Value="0" />
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </Grid.Resources>

            <!-- 自动化测试读取当前页名，保持不可见但留在 UIA 树里 -->
            <TextBlock
                x:Name="CurrentPageTextBlock"
                Margin="{StaticResource AutomationStatusMargin}"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="__CurrentPage"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False"
                Opacity="0"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <CheckBox
                x:Name="IdleStateEnteredCheckBox"
                AutomationProperties.AutomationId="__IdleStateEntered"
                AutomationProperties.Name="Idle state entered"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <TextBox
                x:Name="LogReportingTextBox"
                AutomationProperties.AutomationId="__IdleLog"
                AutomationProperties.Name="Idle log"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <TextBox
                x:Name="ErrorReportingTextBox"
                AutomationProperties.AutomationId="__IdleError"
                AutomationProperties.Name="Idle error"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <Button
                x:Name="GoBackInvokerButton"
                AutomationProperties.AutomationId="__GoBackInvoker"
                AutomationProperties.Name="Go back"
                Click="GoBackInvokerButton_Click"
                Content="Go back"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <Button
                x:Name="CloseAppInvokerButton"
                AutomationProperties.AutomationId="__CloseAppInvoker"
                AutomationProperties.Name="Close app"
                Click="CloseAppInvokerButton_Click"
                Content="Close"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <Button
                x:Name="WaitForIdleInvokerButton"
                AutomationProperties.AutomationId="__WaitForIdleInvoker"
                AutomationProperties.Name="Wait for idle"
                Click="WaitForIdleInvokerButton_Click"
                Content="Wait for idle"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />

            <muxc:NavigationView
                x:Name="RootNavigation"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="True"
                IsSettingsVisible="False"
                IsTabStop="False"
                OpenPaneLength="240"
                SelectionChanged="RootNavigation_SelectionChanged">
