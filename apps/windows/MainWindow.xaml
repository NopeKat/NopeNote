<Window
    x:Class="NopeNote.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="using:Microsoft.UI.Xaml.Input"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid
        x:Name="RootGrid"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="RootGrid_Loaded">
        <Grid.KeyboardAccelerators>
            <input:KeyboardAccelerator
                Key="F"
                Invoked="SearchAccelerator_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏只保留图标与应用名，导航与搜索入口由侧栏承担 -->
        <muxc:TitleBar
            x:Name="AppTitleBar"
            Title="NopeNote"
            IsBackButtonVisible="False">
            <muxc:TitleBar.IconSource>
                <muxc:ImageIconSource ImageSource="/Assets/Tiles/NopeNoteIcon.ico" />
            </muxc:TitleBar.IconSource>
        </muxc:TitleBar>

        <Grid x:Name="AutomationHelpersPanel" Grid.Row="1">
            <Grid.Resources>
                <Style x:Key="AutomationHelperStyle" TargetType="Control">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Width" Value="0" />
                    <Setter Property="Height" Value="0" />
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </Grid.Resources>

            <!-- 自动化测试读取当前页名，保持不可见但留在 UIA 树里 -->
            <TextBlock
                x:Name="CurrentPageTextBlock"
                Margin="{StaticResource AutomationStatusMargin}"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="__CurrentPage"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False"
                Opacity="0"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <CheckBox
                x:Name="IdleStateEnteredCheckBox"
                AutomationProperties.AutomationId="__IdleStateEntered"
                AutomationProperties.Name="Idle state entered"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <TextBox
                x:Name="LogReportingTextBox"
                AutomationProperties.AutomationId="__IdleLog"
                AutomationProperties.Name="Idle log"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <TextBox
                x:Name="ErrorReportingTextBox"
                AutomationProperties.AutomationId="__IdleError"
                AutomationProperties.Name="Idle error"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <Button
                x:Name="GoBackInvokerButton"
                AutomationProperties.AutomationId="__GoBackInvoker"
                AutomationProperties.Name="Go back"
                Click="GoBackInvokerButton_Click"
                Content="Go back"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <Button
                x:Name="CloseAppInvokerButton"
                AutomationProperties.AutomationId="__CloseAppInvoker"
                AutomationProperties.Name="Close app"
                Click="CloseAppInvokerButton_Click"
                Content="Close"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <Button
                x:Name="WaitForIdleInvokerButton"
                AutomationProperties.AutomationId="__WaitForIdleInvoker"
                AutomationProperties.Name="Wait for idle"
                Click="WaitForIdleInvokerButton_Click"
                Content="Wait for idle"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />

            <muxc:NavigationView
                x:Name="RootNavigation"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                IsTabStop="False"
                OpenPaneLength="240"
                SelectionChanged="RootNavigation_SelectionChanged">
                <muxc:NavigationView.MenuItems>
                    <muxc:NavigationViewItem
                        x:Name="SearchNavItem"
                        x:Uid="NavSearch"
                        Content="Search"
                        Tag="Search"
                        AutomationProperties.Name="Search notes"
                        PointerPressed="NavigationItem_PointerPressed"
                        Tapped="NavigationItem_Tapped">
                        <muxc:NavigationViewItem.Icon>
                            <muxc:PathIcon
                                Width="20"
                                Height="20"
                                Data="M13.73 14.44a6.5 6.5 0 1 1 .7-.7l3.42 3.4a.5.5 0 0 1-.63.77l-.07-.06zm-.71-.71A5.5 5.5 0 0 0 15 9.5a5.5 5.5 0 1 0-1.98 4.23"
                                AutomationProperties.AccessibilityView="Raw" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                    <muxc:NavigationViewItem
                        x:Name="NotesNavItem"
                        x:Uid="NavNotes"
                        Content="Notes"
                        Tag="Notes"
                        AutomationProperties.Name="Notes"
                        IsSelected="True"
                        PointerPressed="NavigationItem_PointerPressed"
                        Tapped="NavigationItem_Tapped">
                        <muxc:NavigationViewItem.Icon>
                            <muxc:PathIcon
                                Width="20"
                                Height="20"
                                Data="M5.5 5a.5.5 0 0 0-.5.5v2c0 .28.22.5.5.5h7a.5.5 0 0 0 .5-.5v-2a.5.5 0 0 0-.5-.5zM6 7V6h6v1zM3 4c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zm11 3h.5c.28 0 .5.22.5.5V8a.5.5 0 0 1-.5.5H16zm.5 3.5H16V12h.5a.5.5 0 0 0 .5-.5V10a.5.5 0 0 0-.5-.5M16 13h.5c.28 0 .5.22.5.5V15a.5.5 0 0 1-.5.5H16z"
                                AutomationProperties.AccessibilityView="Raw" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                    <muxc:NavigationViewItem
                        x:Name="TrashNavItem"
                        x:Uid="NavTrash"
                        Content="Trash"
                        Tag="Trash"
                        AutomationProperties.Name="Trash"
                        PointerPressed="NavigationItem_PointerPressed"
                        Tapped="NavigationItem_Tapped">
                        <muxc:NavigationViewItem.Icon>
                            <muxc:PathIcon
                                Width="20"
                                Height="20"
                                Data="M8.5 4h3a1.5 1.5 0 0 0-3 0m-1 0a2.5 2.5 0 0 1 5 0h5a.5.5 0 0 1 0 1h-1.05l-1.2 10.34A3 3 0 0 1 12.27 18H7.73a3 3 0 0 1-2.98-2.66L3.55 5H2.5a.5.5 0 0 1 0-1zM5.74 15.23A2 2 0 0 0 7.73 17h4.54a2 2 0 0 0 1.99-1.77L15.44 5H4.56zM8.5 7.5c.28 0 .5.22.5.5v6a.5.5 0 0 1-1 0V8c0-.28.22-.5.5-.5M12 8a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"
                                AutomationProperties.AccessibilityView="Raw" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                </muxc:NavigationView.MenuItems>

                <muxc:NavigationView.FooterMenuItems>
                    <muxc:NavigationViewItem
                        x:Name="SettingsNavItem"
                        x:Uid="NavSettings"
                        Content="Settings"
                        Tag="Settings"
                        AutomationProperties.Name="Settings"
                        PointerPressed="NavigationItem_PointerPressed"
                        Tapped="NavigationItem_Tapped">
                        <muxc:NavigationViewItem.Icon>
                            <muxc:PathIcon
                                Width="20"
                                Height="20"
                                Data="M1.91 7.38A8.5 8.5 0 0 1 3.7 4.3a.5.5 0 0 1 .54-.13l1.92.68a1 1 0 0 0 1.32-.76l.36-2a.5.5 0 0 1 .4-.4 9 9 0 0 1 3.55 0q.32.08.38.4l.37 2a1 1 0 0 0 1.32.76l1.92-.68a.5.5 0 0 1 .54.13 8.5 8.5 0 0 1 1.78 3.08q.08.31-.15.54l-1.56 1.32a1 1 0 0 0 0 1.52l1.56 1.32a.5.5 0 0 1 .15.54 8.5 8.5 0 0 1-1.78 3.08.5.5 0 0 1-.54.13l-1.92-.68a1 1 0 0 0-1.32.76l-.37 2a.5.5 0 0 1-.38.4 8.5 8.5 0 0 1-3.56 0 .5.5 0 0 1-.39-.4l-.36-2a1 1 0 0 0-1.32-.76l-1.92.68a.5.5 0 0 1-.54-.13 8.5 8.5 0 0 1-1.78-3.08.5.5 0 0 1 .15-.54l1.56-1.32a1 1 0 0 0 0-1.52L2.06 7.92a.5.5 0 0 1-.15-.54m1.06 0 1.3 1.1a2 2 0 0 1 0 3.04l-1.3 1.1q.45 1.19 1.25 2.16l1.6-.58a2 2 0 0 1 2.63 1.53l.3 1.67a8 8 0 0 0 2.5 0l.3-1.67a2 2 0 0 1 2.64-1.53l1.6.58a8 8 0 0 0 1.24-2.16l-1.3-1.1a2 2 0 0 1 0-3.04l1.3-1.1a8 8 0 0 0-1.25-2.16l-1.6.58a2 2 0 0 1-2.63-1.53l-.3-1.67a8 8 0 0 0-2.5 0l-.3 1.67A2 2 0 0 1 5.81 5.8l-1.6-.58a8 8 0 0 0-1.24 2.16M7.5 10a2.5 2.5 0 1 1 5 0 2.5 2.5 0 0 1-5 0m1 0a1.5 1.5 0 1 0 3 0 1.5 1.5 0 0 0-3 0"
                                AutomationProperties.AccessibilityView="Raw" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                </muxc:NavigationView.FooterMenuItems>

                <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
            </muxc:NavigationView>
        </Grid>
    </Grid>
</Window>
