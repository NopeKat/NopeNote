<Window
    x:Class="NopeNote.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <muxc:TitleBar
            x:Name="AppTitleBar"
            Title="NopeNote"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            BackRequested="AppTitleBar_BackRequested"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <muxc:TitleBar.IconSource>
                <muxc:ImageIconSource ImageSource="/Assets/nopenote.png" />
            </muxc:TitleBar.IconSource>
        </muxc:TitleBar>

        <muxc:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="RootNavigation_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem
                    x:Name="NotesNavItem"
                    Content="Notes"
                    Tag="Notes"
                    IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <muxc:FontIcon Glyph="&#xE8A5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem
                    x:Name="SettingsNavItem"
                    Content="Settings"
                    Tag="Settings">
                    <muxc:NavigationViewItem.Icon>
                        <muxc:FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </muxc:NavigationView>
    </Grid>
</Window>
