<Window
    x:Class="NopeNote.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="using:Microsoft.UI.Xaml.Input"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid
        x:Name="RootGrid"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="RootGrid_Loaded">
        <Grid.KeyboardAccelerators>
            <input:KeyboardAccelerator
                Key="F"
                Invoked="SearchAccelerator_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏只保留图标与应用名，导航与搜索入口由侧栏承担 -->
        <muxc:TitleBar
            x:Name="AppTitleBar"
            Title="NopeNote"
            IsBackButtonVisible="False">
            <muxc:TitleBar.IconSource>
                <muxc:ImageIconSource ImageSource="/Assets/Tiles/NopeNoteIcon.ico" />
            </muxc:TitleBar.IconSource>
        </muxc:TitleBar>

        <Grid x:Name="AutomationHelpersPanel" Grid.Row="1">
            <Grid.Resources>
                <Style x:Key="AutomationHelperStyle" TargetType="Control">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Width" Value="0" />
                    <Setter Property="Height" Value="0" />
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </Grid.Resources>

            <!-- 自动化测试读取当前页名，保持不可见但留在 UIA 树里 -->
            <TextBlock
                x:Name="CurrentPageTextBlock"
                Margin="{StaticResource AutomationStatusMargin}"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="__CurrentPage"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False"
                Opacity="0"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <CheckBox
                x:Name="IdleStateEnteredCheckBox"
                AutomationProperties.AutomationId="__IdleStateEntered"
                AutomationProperties.Name="Idle state entered"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <TextBox
                x:Name="LogReportingTextBox"
                AutomationProperties.AutomationId="__IdleLog"
                AutomationProperties.Name="Idle log"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <TextBox
                x:Name="ErrorReportingTextBox"
                AutomationProperties.AutomationId="__IdleError"
                AutomationProperties.Name="Idle error"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <Button
                x:Name="GoBackInvokerButton"
                AutomationProperties.AutomationId="__GoBackInvoker"
                AutomationProperties.Name="Go back"
                Click="GoBackInvokerButton_Click"
                Content="Go back"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <Button
                x:Name="CloseAppInvokerButton"
                AutomationProperties.AutomationId="__CloseAppInvoker"
                AutomationProperties.Name="Close app"
                Click="CloseAppInvokerButton_Click"
                Content="Close"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />
            <Button
                x:Name="WaitForIdleInvokerButton"
                AutomationProperties.AutomationId="__WaitForIdleInvoker"
                AutomationProperties.Name="Wait for idle"
                Click="WaitForIdleInvokerButton_Click"
                Content="Wait for idle"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource AutomationHelperStyle}" />

            <muxc:NavigationView
                x:Name="RootNavigation"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                IsTabStop="False"
                OpenPaneLength="240"
                SelectionChanged="RootNavigation_SelectionChanged">
                <muxc:NavigationView.MenuItems>
                    <muxc:NavigationViewItem
                        x:Name="SearchNavItem"
                        x:Uid="NavSearch"
                        Content="Search"
                        Tag="Search"
                        AutomationProperties.Name="Search notes"
                        PointerPressed="NavigationItem_PointerPressed"
                        Tapped="NavigationItem_Tapped">
                        <muxc:NavigationViewItem.Icon>
                            <!-- Fluent UI System Icons: search_20_regular; ink 15.69 x 15.69 -> 17.50 px long edge, centered on 20. Source 1 px bands scale with the correction. -->
                            <muxc:PathIcon
                                Width="20"
                                Height="20"
                                Data="F1 M13.937 14.72A7.25 7.25 0 1 1 14.718 13.939L18.532 17.731A0.558 0.558 0 0 1 17.829 18.59L17.751 18.523ZM13.145 13.928A6.134 6.134 0 0 0 15.353 9.21 6.134 6.134 0 1 0 13.145 13.928"
                                AutomationProperties.AccessibilityView="Raw" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                    <muxc:NavigationViewItem
                        x:Name="NotesNavItem"
                        x:Uid="NavNotes"
                        Content="Notes"
                        Tag="Notes"
                        AutomationProperties.Name="Notes"
                        IsSelected="True"
                        PointerPressed="NavigationItem_PointerPressed"
                        Tapped="NavigationItem_Tapped">
                        <muxc:NavigationViewItem.Icon>
                            <!-- Fluent UI System Icons: notebook_20_regular; ink 14.00 x 16.00 -> 17.50 px long edge, centered on 20. Source 1 px bands scale with the correction. -->
                            <muxc:PathIcon
                                Width="20"
                                Height="20"
                                Data="F1 M5.078 4.531A0.547 0.547 0 0 0 4.531 5.078V7.266C4.531 7.572 4.772 7.813 5.078 7.813H12.734A0.547 0.547 0 0 0 13.281 7.266V5.078A0.547 0.547 0 0 0 12.734 4.531ZM5.625 6.719V5.625H12.188V6.719ZM2.344 3.438C2.344 2.234 3.328 1.25 4.531 1.25H13.281A2.188 2.188 0 0 1 15.469 3.438V16.563A2.188 2.188 0 0 1 13.281 18.75H4.531A2.188 2.188 0 0 1 2.344 16.563ZM4.531 2.344A1.094 1.094 0 0 0 3.438 3.438V16.563A1.094 1.094 0 0 0 4.531 17.656H13.281A1.094 1.094 0 0 0 14.375 16.563V3.438A1.094 1.094 0 0 0 13.281 2.344ZM16.563 5.625H17.109C17.416 5.625 17.656 5.866 17.656 6.172V7.813A0.547 0.547 0 0 1 17.109 8.359H16.563ZM17.109 9.453H16.563V12.188H17.109A0.547 0.547 0 0 0 17.656 11.641V10A0.547 0.547 0 0 0 17.109 9.453M16.563 13.281H17.109C17.416 13.281 17.656 13.522 17.656 13.828V15.469A0.547 0.547 0 0 1 17.109 16.016H16.563Z"
                                AutomationProperties.AccessibilityView="Raw" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                    <muxc:NavigationViewItem
                        x:Name="TrashNavItem"
                        x:Uid="NavTrash"
                        Content="Trash"
                        Tag="Trash"
                        AutomationProperties.Name="Trash"
                        PointerPressed="NavigationItem_PointerPressed"
                        Tapped="NavigationItem_Tapped">
                        <muxc:NavigationViewItem.Icon>
                            <!-- Fluent UI System Icons: delete_20_regular; ink 16.00 x 16.50 -> 17.50 px long edge, centered on 20. Source 1 px bands scale with the correction. -->
                            <muxc:PathIcon
                                Width="20"
                                Height="20"
                                Data="F1 M8.409 3.902H11.591A1.591 1.591 0 0 0 8.409 3.902M7.348 3.902A2.652 2.652 0 0 1 12.652 3.902H17.955A0.53 0.53 0 0 1 17.955 4.962H16.841L15.568 15.929A3.182 3.182 0 0 1 12.408 18.75H7.592A3.182 3.182 0 0 1 4.432 15.929L3.159 4.962H2.045A0.53 0.53 0 0 1 2.045 3.902ZM5.482 15.812A2.121 2.121 0 0 0 7.592 17.689H12.408A2.121 2.121 0 0 0 14.518 15.812L15.77 4.962H4.23ZM8.409 7.614C8.706 7.614 8.939 7.847 8.939 8.144V14.508A0.53 0.53 0 0 1 7.879 14.508V8.144C7.879 7.847 8.112 7.614 8.409 7.614M12.121 8.144A0.53 0.53 0 0 0 11.061 8.144V14.508A0.53 0.53 0 0 0 12.121 14.508Z"
                                AutomationProperties.AccessibilityView="Raw" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                </muxc:NavigationView.MenuItems>

                <muxc:NavigationView.FooterMenuItems>
                    <muxc:NavigationViewItem
                        x:Name="SettingsNavItem"
                        x:Uid="NavSettings"
                        Content="Settings"
                        Tag="Settings"
                        AutomationProperties.Name="Settings"
                        PointerPressed="NavigationItem_PointerPressed"
                        Tapped="NavigationItem_Tapped">
                        <muxc:NavigationViewItem.Icon>
                            <!-- Fluent UI System Icons: settings_20_regular; ink 16.32 x 17.11 -> 17.50 px long edge, centered on 20. Source 1 px bands scale with the correction. -->
                            <muxc:PathIcon
                                Width="20"
                                Height="20"
                                Data="F1 M1.719 7.312A8.695 8.695 0 0 1 3.55 4.161 0.511 0.511 0 0 1 4.103 4.028L6.067 4.724A1.023 1.023 0 0 0 7.417 3.946L7.785 1.9A0.511 0.511 0 0 1 8.194 1.491 9.207 9.207 0 0 1 11.826 1.491Q12.153 1.573 12.215 1.9L12.593 3.946A1.023 1.023 0 0 0 13.944 4.724L15.908 4.028A0.511 0.511 0 0 1 16.46 4.161 8.695 8.695 0 0 1 18.281 7.312Q18.363 7.629 18.128 7.864L16.532 9.215A1.023 1.023 0 0 0 16.532 10.769L18.128 12.12A0.511 0.511 0 0 1 18.281 12.672 8.695 8.695 0 0 1 16.46 15.823 0.511 0.511 0 0 1 15.908 15.956L13.944 15.26A1.023 1.023 0 0 0 12.593 16.038L12.215 18.084A0.511 0.511 0 0 1 11.826 18.493 8.695 8.695 0 0 1 8.184 18.493 0.511 0.511 0 0 1 7.785 18.084L7.417 16.038A1.023 1.023 0 0 0 6.067 15.26L4.103 15.956A0.511 0.511 0 0 1 3.55 15.823 8.695 8.695 0 0 1 1.729 12.672 0.511 0.511 0 0 1 1.883 12.12L3.479 10.769A1.023 1.023 0 0 0 3.479 9.215L1.872 7.864A0.511 0.511 0 0 1 1.719 7.312M2.803 7.312L4.133 8.437A2.046 2.046 0 0 1 4.133 11.547L2.803 12.672Q3.264 13.89 4.082 14.882L5.719 14.289A2.046 2.046 0 0 1 8.409 15.854L8.716 17.562A8.184 8.184 0 0 0 11.274 17.562L11.58 15.854A2.046 2.046 0 0 1 14.281 14.289L15.918 14.882A8.184 8.184 0 0 0 17.186 12.672L15.857 11.547A2.046 2.046 0 0 1 15.857 8.437L17.186 7.312A8.184 8.184 0 0 0 15.908 5.102L14.271 5.696A2.046 2.046 0 0 1 11.58 4.13L11.274 2.422A8.184 8.184 0 0 0 8.716 2.422L8.409 4.13A2.046 2.046 0 0 1 5.709 5.696L4.072 5.102A8.184 8.184 0 0 0 2.803 7.312M7.437 9.992A2.557 2.557 0 1 1 12.552 9.992 2.557 2.557 0 0 1 7.437 9.992M8.46 9.992A1.534 1.534 0 1 0 11.529 9.992 1.534 1.534 0 0 0 8.46 9.992"
                                AutomationProperties.AccessibilityView="Raw" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                </muxc:NavigationView.FooterMenuItems>

                <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
            </muxc:NavigationView>
        </Grid>
    </Grid>
</Window>
